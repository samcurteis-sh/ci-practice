echo "Starting pre-commit checks..."

echo "🔍 Running TypeScript type check..."
npm run typecheck || { echo "❌ TypeScript type checking failed. Fix the errors before committing!"; exit 1; }
echo "✅ TypeScript type check passed."

echo "🔍 Running lint-staged..."
npx lint-staged
echo "✅ Linting completed successfully."

echo "🧪 Running tests..."
npm run test:silent || { echo "❌ Tests failed. Fix them before committing!"; exit 1; }
echo "✅ All tests passed."

echo "Pre-commit checks completed successfully. Proceeding with commit."