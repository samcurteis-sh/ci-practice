#!/bin/bash
set -e  # Exit immediately if a command fails

echo "Starting pre-commit checks..."

echo "🔍 Running TypeScript type check..."
npm run typecheck || { echo "❌ TypeScript type checking failed. Fix the errors before committing!"; exit 1; }
echo "✅ TypeScript type check passed."

echo "🔍 Running lint-staged..."
npx lint-staged
echo "✅ Linting completed successfully."

# Get list of staged files
CHANGED_FILES=$(git diff --cached --name-only)

changed_app1=false
changed_app2=false
changed_shared=false

# Check for changes in each path
if echo "$CHANGED_FILES" | grep -q "^apps/app1/"; then
  changed_app1=true
fi

if echo "$CHANGED_FILES" | grep -q "^apps/app2/"; then
  changed_app2=true
fi

if echo "$CHANGED_FILES" | grep -q "^shared/"; then
  changed_shared=true
fi

# Decide what to run
if [[ "$changed_shared" = true || ( "$changed_app1" = true && "$changed_app2" = true ) ]]; then
  echo "🛠 Changes detected in shared code — running tests for both apps..."
  npm run coverage || { echo "❌ Tests failed."; exit 1; }
  echo "✅ All relevant tests passed."
  exit 0
elif [[ "$changed_app1" = true ]]; then
  echo "🛠 Changes detected in app1 — running app1 tests..."
  npm run coverage:app1 || { echo "❌ Tests failed for app1"; exit 1; }
elif [[ "$changed_app2" = true ]]; then
  echo "🛠 Changes detected in app2 — running app2 tests..."
  npm run coverage:app2 || { echo "❌ Tests failed for app2"; exit 1; }
else
  echo "✅ No changes made to applications. Tests skipped."
  exit 0
fi

echo "✅ All relevant tests passed."