{
  "name": "ci-practice",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:app1": "next dev apps/app1 --turbopack -p 3000",
    "dev:app2": "next dev apps/app2 --turbopack -p 3001",
    "build:app1": "next build apps/app1",
    "build:app2": "next build apps/app2",
    "start:app1": "next start apps/app1 -p 3000",
    "start:app2": "next start apps/app2 -p 3001",
    "lint": "next lint",
    "prepare": "husky",
    "test": "vitest run",
    "watch": "vitest watch",
    "coverage": "vitest run --coverage",
    "coverage:watch": "vitest watch --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.0.0",
    "istanbul": "^0.4.5",
    "lint-staged": "^16.1.4",
    "next": "15.4.6",
    "prettier": "^3.6.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.54.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-istanbul": "^3.2.4",
    "eslint": "^9",
    "eslint-config-next": "15.4.6",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.ts": "eslint --cache --fix",
    "*.{ts,tsx,css,md}": "prettier --write"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}